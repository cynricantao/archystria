[Unit]
Description=Hypr Rice Quickshell panels and notification daemon
PartOf=hypr-rice-session.target
After=graphical-session.target pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/qs -c hypr-rice
Restart=on-failure
RestartSec=1

[Install]
WantedBy=hypr-rice-session.target
