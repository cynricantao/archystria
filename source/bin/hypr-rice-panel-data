#!/usr/bin/env python3
"""Lightweight JSON backend for the Hyprland control-center panels.

The long-running ``stream`` command emits one newline-delimited JSON snapshot per
second.  Mutating commands are deliberately narrow, use argument vectors (never
a shell), and persist state with atomic replacements.
"""

from __future__ import annotations

import argparse
import copy
from concurrent.futures import Future, ThreadPoolExecutor
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import ipaddress
import json
import math
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import ssl
import stat
import subprocess
import sys
import tempfile
import time
from typing import Any, Callable, Sequence
import urllib.error
import urllib.parse
import urllib.request

COMMAND_TIMEOUT = 5
WEATHER_CACHE_SECONDS = 30 * 60
WEATHER_TIMEOUT = 7
MAX_HTTP_BYTES = 2 * 1024 * 1024
VPN_TYPES = {"vpn", "wireguard"}
PHYSICAL_TYPES = {"ethernet", "wifi"}
MAC_PATTERN = re.compile(r"^(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$")
MENU_KEY_PATTERN = re.compile(r"^[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*$")

DEFAULT_SETTINGS: dict[str, Any] = {
    "schema_version": 1,
    "dnd": False,
    "weather": {
        "city": "",
        "name": "",
        "country": "",
        "latitude": None,
        "longitude": None,
        "timezone": "auto",
    },
    "menu": {
        "compactness": "normal",
        "modules": {
            "active_application": True,
            "tray": True,
            "network": True,
            "caffeinate": True,
            "media": True,
            "microphone": False,
            "battery": False,
            "weather": False,
            "updates": False,
            "control_center": True,
        },
        "order": {
            "left": ["launcher", "workspaces", "active_application"],
            "center": [],
            "right": ["media", "tray", "caffeinate", "network", "control_center", "clock", "power"],
        },
        "tray_hidden": [],
    },
}

MENU_ID_TO_BAR = {
    "active_application": "activeApp",
    "control_center": "controlCenter",
}


def menu_alias_from_bar(menu_bar: dict[str, Any]) -> dict[str, Any]:
    """Return the backend's compatibility view of Waybar settings."""
    alias = copy.deepcopy(DEFAULT_SETTINGS["menu"])
    density = menu_bar.get("density")
    if density in {"compact", "normal", "relaxed"}:
        alias["compactness"] = density
    modules = menu_bar.get("modules")
    if isinstance(modules, dict):
        reverse_ids = {value: key for key, value in MENU_ID_TO_BAR.items()}
        for key, value in modules.items():
            alias["modules"][reverse_ids.get(key, key)] = bool(value)
    order = menu_bar.get("rightOrder")
    if isinstance(order, list):
        reverse_ids = {value: key for key, value in MENU_ID_TO_BAR.items()}
        alias["order"]["right"] = [reverse_ids.get(item, item) for item in order if isinstance(item, str)]
    hidden = menu_bar.get("trayHidden")
    if isinstance(hidden, list):
        alias["tray_hidden"] = [item for item in hidden if isinstance(item, str)]
    return alias


def menu_bar_from_alias(menu: dict[str, Any], existing: Any = None) -> dict[str, Any]:
    """Merge a compatibility menu mutation into the authoritative Waybar tree."""
    result = copy.deepcopy(existing) if isinstance(existing, dict) else {}
    result["density"] = menu.get("compactness", result.get("density", "normal"))
    modules = result.get("modules") if isinstance(result.get("modules"), dict) else {}
    for key, value in (menu.get("modules") or {}).items():
        modules[MENU_ID_TO_BAR.get(key, key)] = bool(value)
    result["modules"] = modules
    right = (menu.get("order") or {}).get("right")
    if isinstance(right, list):
        result["rightOrder"] = [MENU_ID_TO_BAR.get(item, item) for item in right]
    hidden = menu.get("tray_hidden")
    if isinstance(hidden, list):
        result["trayHidden"] = [item for item in hidden if isinstance(item, str)]
    return result


