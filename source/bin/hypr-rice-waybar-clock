#!/usr/bin/env python3
"""Stream the Waybar date/time and unread-notification indicator."""

from __future__ import annotations

import argparse
import calendar
import datetime as dt
import json
import os
import time
from pathlib import Path


def unread_count() -> int:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    path = Path(runtime) / "hypr-rice-notifications.json"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return max(0, int(value.get("unread", 0)))
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        return 0


def payload() -> dict[str, object]:
    now = dt.datetime.now().astimezone()
    unread = unread_count()
    text = now.strftime("%a %d %b  %H:%M")
    if unread:
        text += "  ●"
    tooltip = now.strftime("%A, %d %B %Y · %H:%M:%S\n") + calendar.month(now.year, now.month)
    return {
        "text": text,
        "tooltip": tooltip,
        "class": "unread" if unread else "read",
        "alt": "unread" if unread else "read",
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--once", action="store_true")
    args = parser.parse_args()
    try:
        while True:
            print(json.dumps(payload(), separators=(",", ":")), flush=True)
            if args.once:
                return 0
            time.sleep(1)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
